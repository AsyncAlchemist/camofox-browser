# camofox environment variables.
#
# Copy to .env and uncomment what you need. Everything here is optional —
# camofox runs with sensible defaults if no .env is present. Values shown are
# the defaults (or placeholders); uncomment a line to override.

# ── CLI ──────────────────────────────────────────────────────────────────────
# Where the CLI talks to the server, and how sessions/tabs are grouped.
# CAMOFOX_URL=http://127.0.0.1:9377
# CAMOFOX_USER=cli
# CAMOFOX_SESSION=default

# ── Server / auth ────────────────────────────────────────────────────────────
# Bind host: 127.0.0.1 = local-only (auth bypassed for local callers);
# 0.0.0.0 = all interfaces (auth required). Default 0.0.0.0.
# CAMOFOX_HOST=127.0.0.1
# CAMOFOX_PORT=9377
# API key for auth-gated endpoints (eval, cookies, traces, ...). `camofox serve`
# auto-generates one at ~/.camofox/api-key if unset.
# CAMOFOX_API_KEY=
# Admin key, required for `camofox stop`.
# CAMOFOX_ADMIN_KEY=

# ── Residential proxies (byteful) ────────────────────────────────────────────
# Used by `camofox proxy list` to fetch residential proxies from byteful via the
# sibling byteful-sdk. Generate keys at dashboard.byteful.com/developer/api-key.
# These can also live in ~/.camofox/byteful.env or the sibling byteful-sdk/.env.
# BYTEFUL_API_PUBLIC_KEY=pub_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# BYTEFUL_API_PRIVATE_KEY=priv_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Override the Python interpreter (must have the byteful package installed) and
# the byteful-sdk checkout location. Defaults: ../byteful-sdk/.venv/bin/python.
# BYTEFUL_PYTHON=/path/to/python
# BYTEFUL_SDK_DIR=/path/to/byteful-sdk
#
# `camofox proxy use <line>` persists its choice to ~/.camofox/proxy.json; the
# PROXY_* vars below override that stored assignment.

# ── Proxy (manual / non-byteful) ─────────────────────────────────────────────
# Simple single-endpoint proxy:
# PROXY_HOST=166.88.179.132
# PROXY_PORT=46040
# PROXY_USERNAME=myuser
# PROXY_PASSWORD=mypass
# Multiple ports for round-robin (range or comma list); takes precedence over PROXY_PORT:
# PROXY_PORTS=10001-10010
#
# Backconnect (rotating sticky sessions: Decodo, Bright Data, Oxylabs, ...):
# PROXY_STRATEGY=backconnect
# PROXY_PROVIDER=decodo
# PROXY_BACKCONNECT_HOST=gate.provider.com
# PROXY_BACKCONNECT_PORT=7000
# PROXY_SESSION_DURATION_MINUTES=10
#
# Geo targeting passed to the provider (and recorded for byteful assignments):
# PROXY_COUNTRY=us
# PROXY_STATE=
# PROXY_CITY=
# PROXY_ZIP=

# ── Locale / timezone / geolocation spoofing ─────────────────────────────────
# Camoufox's GeoIP (auto locale/timezone/geo from the exit IP) is OFF by default
# on this build because it crashes the renderer. Pin geo by hand instead, and
# keep it coherent with the proxy's country:
# CAMOFOX_LOCALE=es-AR
# TZ=America/Argentina/Buenos_Aires
# CAMOFOX_GEOLOCATION=-34.6037,-58.3816
# CAMOFOX_GEOIP=true            # only set on a future build that fixes the crash
# OS to spoof in the fingerprint: windows | macos | linux | host. Default windows.
# CAMOFOX_SPOOF_OS=windows
# Block WebRTC entirely (default leak-safe behavior keeps RTC available):
# CAMOFOX_BLOCK_WEBRTC=true

# ── Markdown capture ─────────────────────────────────────────────────────────
# `camofox markdown <url>` via a Cloudflare Browser Rendering Worker. Falls back
# to ~/.camofox/markdown-url and ~/.camofox/markdown-token if unset.
# CAMOFOX_MARKDOWN_URL=https://your-worker.example.workers.dev/markdown
# CAMOFOX_MARKDOWN_TOKEN=
# CAMOFOX_MARKDOWN_TIMEOUT_MS=45000

# ── Limits / timeouts ────────────────────────────────────────────────────────
# MAX_SESSIONS=50
# MAX_TABS_PER_SESSION=10
# MAX_TABS_GLOBAL=50
# MAX_CONCURRENT_PER_USER=3
# SESSION_TIMEOUT_MS=600000
# TAB_INACTIVITY_MS=300000
# NAVIGATE_TIMEOUT_MS=25000

# ── VNC (optional live-view plugin) ──────────────────────────────────────────
# ENABLE_VNC=1
# VNC_RESOLUTION=1280x720
# VNC_PASSWORD=
# VNC_PORT=5900
# NOVNC_PORT=6080
# VIEW_ONLY=false

# ── Observability (optional) ─────────────────────────────────────────────────
# PROMETHEUS_ENABLED=1
# SENTRY_DSN=
